<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Recite.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="Recite.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1200" Height="760"
        Title="Recite — bibliography manager">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Padding="16,10" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Recite" Classes="h1" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} references'}" Foreground="White" FontSize="12" />
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding LibraryPath}" Classes="muted" VerticalAlignment="Center"
                           Margin="0,0,12,0" MaxWidth="480" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LibraryPath}" />
                <Button Grid.Column="3" Content="Checkpoint ↧" Command="{Binding CheckpointCommand}"
                        ToolTip.Tip="Write the git-friendly text tree" />
            </Grid>
        </Border>

        <!-- Body: nav + content -->
        <Grid Grid.Row="1" ColumnDefinitions="200,*">
            <ListBox Grid.Column="0" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                     Background="Transparent" Padding="6" BorderThickness="0,0,1,0"
                     BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:NavItem">
                        <TextBlock Text="{Binding Title}" Padding="6,8" FontSize="14" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ContentControl Grid.Column="1" Content="{Binding SelectedSection.Content}" Margin="0" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="16,6" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Status}" Classes="muted" FontSize="12" />
        </Border>
    </Grid>
</Window>
